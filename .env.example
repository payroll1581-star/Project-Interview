# SMTP settings used by server/lib/mailer.js to send interview emails (confirmations,
# reminders, and "interview updated" notices).
# Copy this file to .env and fill in real values to enable sending.
# Left unset, emails are logged to the server console instead of actually being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# IANA timezone used to show interview times in emails (dates are stored in UTC).
APP_TIMEZONE=Asia/Bangkok

# Comma-separated allowlist of origins allowed to call this API cross-origin.
# Leave unset in dev (Vite proxies the frontend to the API on the same origin).
# Only needed if the frontend is ever deployed on a different origin than the API,
# e.g. CORS_ORIGIN=https://interviews.example.com
CORS_ORIGIN=

# Port the production server (npm start) listens on. Defaults to 3001.
PORT=3001

# Where the live database and uploaded resumes are stored. For a real deployment put BOTH in a
# folder that is NOT synced by OneDrive/Dropbox (syncing a database that is being written to can
# corrupt it), e.g. C:\InterviewApp\data. Leave unset in development.
# DB_PATH defaults to server/data/app.db. RESUME_UPLOAD_DIR defaults, on Windows, to
# C:\Users\Asus\OneDrive\Desktop\Rasume -- always set it explicitly on any other machine.
DB_PATH=
RESUME_UPLOAD_DIR=

# Folder for nightly backups (npm run db:backup): dated database copies plus a mirror of the
# resumes. Pointing it at a OneDrive-synced folder is fine -- those are finished copies, not
# the live database.
BACKUP_DIR=
